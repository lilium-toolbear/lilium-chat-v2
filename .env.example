# Copy to .env and adjust. `podman compose` reads .env automatically.

# --- Database (dev) ---
DB_PORT=5432
# DB_HOSTNAME=postgres   # only when running the app outside compose

# --- Auth (spec §6.1) ---
# ToolBear JWT secret (HS256) — same value as the old Worker deployment.
JWT_SECRET=

# --- S3 / SeaweedFS (spec §6.2) ---
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_BUCKET=
PRESIGN_TTL_SECONDS=300

# --- Observability (spec §10 / issue #21) ---
SENTRY_DSN=
# Same Sentry instance/environment as the old Worker (SENTRY_ENVIRONMENT).
SENTRY_ENVIRONMENT=production
# Read-only SQL debug endpoint token (old repo: DEBUG_TOKEN; unset ⇒ disabled)
DEBUG_TOKEN=

# --- Housekeeping GC (spec §2.2 / issue #21) ---
# Sweep cadence + per-task TTLs; defaults match config.exs.
HOUSEKEEPING_INTERVAL_MS=60000
HOUSEKEEPING_PENDING_ATTACHMENT_TTL_MS=600000
HOUSEKEEPING_DELIVERY_RETENTION_MS=60000

# Note: CORS origins are a static compile-time whitelist
# (config :lilium_chat, :cors, origins — copied from the old repo).

# --- Prod endpoint ---
# PHX_HOST=chat.kuma.homes
# PORT=4000
# PHX_SERVER=true   # only for `bin/lilium_chat start` directly; bin/server sets it
